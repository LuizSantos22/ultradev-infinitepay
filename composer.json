{
    "name": "ultradev/infinitepay-openmage",
    "description": "InfinitePay Checkout Integrado (Pix e Cartão) via API para OpenMage 20.x / PHP 8.1+",
    "type": "magento-module",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "UltraDev",
            "email": "contato@ultradev.com.br",
            "homepage": "https://ultradev.com.br"
        }
    ],
    "require": {
        "php": ">=8.1",
        "magento-hackathon/magento-composer-installer": "*"
    },
    "extra": {
        "magento-root-dir": "../../",
        "magento-deploystrategy": "copy",
        "auto-append-gitignore": true
    },
    "keywords": ["openmage", "magento", "infinitepay", "checkout", "pix", "ultradev"]
}
